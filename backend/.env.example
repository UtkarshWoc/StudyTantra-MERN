PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/studytantra
# At least 16 characters; use a long random string in production
JWT_SECRET=your_jwt_secret_here_min_16_chars

# Frontend URL (used for links in emails) and allowed CORS origins (comma-separated)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# AI: gemini (default) or mock (offline deterministic responses for dev/tests; not allowed in production)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Max AI requests (chat, generation, summaries) per user per hour
AI_RATE_LIMIT_PER_HOUR=60
# Retrieval: app (score embeddings in Node, default) or atlas (MongoDB Atlas Vector Search
# index named "chunk_embeddings" on chunks.embedding, 768 dims, cosine; filter field: document)
VECTOR_SEARCH=app

# Storage: cloudinary (default) or local (PDFs on disk in LOCAL_UPLOAD_DIR — dev/tests)
STORAGE_DRIVER=cloudinary
LOCAL_UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email via Resend (verification + password reset). Without a key, emails are printed to the log.
RESEND_API_KEY=
EMAIL_FROM=StudyTantra <onboarding@resend.dev>

# Optional: Google sign-in (OAuth client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=

# Optional: error monitoring
SENTRY_DSN=
LOG_LEVEL=
